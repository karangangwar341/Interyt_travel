# Database — SQLite for local dev (no setup needed). For production, point
# prisma/schema.prisma's datasource at "postgresql" and use a real connection
# string here instead, e.g. postgresql://user:password@host:5432/db
DATABASE_URL="file:./dev.db"

# NextAuth (admin authentication)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Used once by `npm run seed:admin` to create the first AdminUser row (the
# password is hashed before storage). Change these before seeding, and
# rotate the password from the admin UI after first login.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Site config (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_PHONE_NUMBER="+91XXXXXXXXXX"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourbrand"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/yourbrand"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@yourbrand"
